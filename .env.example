# Copy to .env and replace this placeholder. Never commit the real key.
OPENAI_API_KEY=your-openai-api-key

# Optional; build_llm defaults to gpt-4o-mini when this is unset.
OPENAI_MODEL=gpt-4o-mini

# Optional locally (defaults to bookings.db); set to /data/bookings.db on Railway.
BOOKINGS_DB_PATH=bookings.db
